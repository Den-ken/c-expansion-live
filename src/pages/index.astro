---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Activities from '../components/Activities.astro';
import Podcasts from '../components/Podcasts.astro';
import Benefits from '../components/Benefits.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Expansión Live — Agencia de influencers en Perú" description="Agencia de influencers en Perú. Te formamos y te representamos: bailes en vivo, transmisiones, podcasts, risas y shows con el público. Para mayores de 18 años, con contrato firmado.">
  <Nav />
  <main id="main">
    <Hero />
    <Ticker />
    <Activities />
    <Podcasts />
    <Benefits />
    <Join />
  </main>
  <Footer />
</Base>
