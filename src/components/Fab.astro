---
import { contact } from '../data/site';
// Con número de WhatsApp configurado abre el chat; mientras esté vacío lleva al formulario.
const wa = contact.whatsapp.replace(/\D/g, '');
const href = wa
  ? `https://wa.me/${wa}?text=${encodeURIComponent('Hola Expansión Live, quiero información para postular.')}`
  : '#postula';
---
<a class="fab" href={href} aria-label={wa ? 'Escribir por WhatsApp a Expansión Live' : 'Ir al formulario para postular'} {...(wa ? { target: '_blank', rel: 'noopener' } : {})}>
  <span class="tip" aria-hidden="true">¿Quieres ser influencer? Postula</span>
  <span class="btn-wa">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
    </svg>
  </span>
</a>
<style>
  .fab { position: fixed; z-index: 85; right: max(1.1rem, env(safe-area-inset-right)); bottom: max(1.1rem, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: .9rem; }
  .btn-wa { position: relative; display: grid; place-items: center; width: 3.6rem; height: 3.6rem; border-radius: 50%; background: #25d366; color: #fff; box-shadow: 0 10px 28px rgba(0, 0, 0, .45); transition: transform .4s var(--out), box-shadow .3s; }
  .fab:hover .btn-wa, .fab:focus-visible .btn-wa { transform: scale(1.08); box-shadow: 0 12px 34px rgba(37, 211, 102, .35); }
  .tip { order: -1; position: relative; padding: .8rem 1.1rem; background: var(--black); color: var(--white); border: 1px solid var(--line); border-radius: 12px; font-size: .9rem; font-weight: 500; line-height: 1.3; white-space: nowrap; box-shadow: 0 10px 28px rgba(0, 0, 0, .35); opacity: 0; transform: translateX(10px); pointer-events: none; transition: opacity .35s var(--out), transform .45s var(--out); }
  .tip::after { content: ''; position: absolute; right: -5px; top: 50%; width: 10px; height: 10px; margin-top: -5px; background: var(--black); border-top: 1px solid var(--line); border-right: 1px solid var(--line); transform: rotate(45deg); }
  .fab:hover .tip, .fab:focus-visible .tip { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .tip { animation: tip 8s 3s both; }
    .fab:hover .tip, .fab:focus-visible .tip { animation: none; }
    .btn-wa::before { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #25d366; animation: ring 2.6s ease-out infinite; }
  }
  @keyframes tip { 0% { opacity: 0; transform: translateX(10px); } 8%, 88% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateX(10px); } }
  @keyframes ring { from { transform: scale(1); opacity: .7; } to { transform: scale(1.55); opacity: 0; } }
  @media (max-width: 560px) { .btn-wa { width: 3.3rem; height: 3.3rem; } .tip { white-space: normal; max-width: 11.5rem; font-size: .82rem; padding: .65rem .85rem; } }
</style>
