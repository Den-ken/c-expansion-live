---
import { activities } from '../data/site';
---
<section class="section light acts" id="que-hacemos" aria-labelledby="acts-h">
  <p class="label mono" data-reveal>01 · Qué hacemos</p>
  <h2 id="acts-h" data-split>Tu talento, <em>en vivo.</em></h2>
  <ul class="cards">
    {activities.map((a, i) => (
      <li class="card" style={`--i:${i}`}>
        <img src={a.image} alt="" style={`object-position:${a.pos}`} loading="lazy" decoding="async" />
        <span class="num mono">{a.n}</span>
        <span class="stock mono">Foto de stock</span>
        <div class="cap">
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
<style>
  .acts h2 { font-size: clamp(3rem, 8.4vw, 8.6rem); max-width: 12ch; }
  /* tarjetas verticales tipo historias, escalonadas */
  .cards { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(.8rem, 1.6vw, 1.4rem); margin-top: clamp(2rem, 4vw, 3.5rem); padding-bottom: 2.6rem; }
  .card { position: relative; overflow: hidden; border-radius: 1.5rem; aspect-ratio: 3 / 4.5; background: var(--black); color: var(--warm); display: flex; align-items: flex-end; isolation: isolate; transition: transform .6s var(--out); }
  .card:nth-child(even) { transform: translateY(2.6rem); }
  .card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s var(--out); }
  .card::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(8, 8, 8, .94), rgba(8, 8, 8, .1) 62%); }
  .card:hover { transform: translateY(-.4rem) rotate(-1.6deg); }
  .card:nth-child(even):hover { transform: translateY(2.2rem) rotate(1.6deg); }
  .card:hover img { transform: scale(1.07); }
  .num { position: absolute; top: .9rem; left: .9rem; background: var(--gold-lit); color: var(--black); padding: .3rem .7rem; border-radius: 999px; }
  .stock { position: absolute; top: .9rem; right: .9rem; font-size: .54rem; background: rgba(8, 8, 8, .7); padding: .25rem .55rem; border-radius: 999px; }
  .cap { padding: clamp(1rem, 2vw, 1.5rem); display: grid; gap: .5rem; }
  .card h3 { font-size: clamp(1.7rem, 2.6vw, 2.5rem); color: var(--white); }
  .card p { font-size: .95rem; opacity: .9; line-height: 1.45; }
  @media (max-width: 960px) {
    /* en pantallas pequeñas se desliza de lado, como las historias */
    .cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 1rem; margin-inline: calc(var(--pad) * -1); padding: 0 var(--pad) 1rem; scrollbar-width: none; }
    .cards::-webkit-scrollbar { display: none; }
    .card, .card:nth-child(even) { flex: 0 0 min(72vw, 19rem); transform: none; scroll-snap-align: center; }
    .card:hover, .card:nth-child(even):hover { transform: none; }
  }
</style>
