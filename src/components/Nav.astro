---
import Logo from './Logo.astro';
---
<header class="nav">
  <a href="#top" class="brand" aria-label="Expansión Live, inicio"><Logo /></a>
  <nav aria-label="Principal">
    <button class="burger" aria-expanded="false" aria-controls="menu"><span class="mono">Menú</span></button>
    <ul id="menu">
      <li><a href="#que-hacemos">Qué hacemos</a></li>
      <li><a href="#podcasts">Podcasts</a></li>
      <li><a href="#beneficios">Beneficios</a></li>
      <li><a href="#postula" class="cta">Postula</a></li>
    </ul>
  </nav>
</header>
<style>
  /* barra flotante en forma de píldora: lo contrario a la barra completa y seria de SPACE */
  .nav { position: fixed; z-index: 90; top: .9rem; left: var(--pad); right: var(--pad); max-width: 68rem; margin-inline: auto; display: flex; justify-content: space-between; align-items: center; padding: .55rem .55rem .55rem 1.2rem; border-radius: 999px; background: rgba(8, 8, 8, .82); border: 1px solid var(--line); transition: background .4s, top .4s; }
  .nav.solid { background: rgba(8, 8, 8, .94); }
  .brand { display: block; --lm: 2.1rem; --lf: 1.2rem; }
  ul { display: flex; gap: clamp(1rem, 2.2vw, 2rem); list-style: none; align-items: center; }
  li a { font-family: var(--f-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; position: relative; padding: .35rem 0; }
  li a::after { content: ''; position: absolute; left: 0; bottom: 0; height: 1px; width: 100%; background: var(--gold-lit); transform: scaleX(0); transform-origin: left; transition: transform .4s var(--out); }
  li a:hover::after, li a:focus-visible::after, li a[aria-current='true']::after { transform: scaleX(1); }
  li a[aria-current='true'] { color: var(--gold-lit); }
  li a.cta { background: var(--gold-lit); color: var(--black); padding: .65rem 1.2rem; border-radius: 999px; transition: background .3s; }
  li a.cta::after { display: none; }
  li a.cta:hover, li a.cta:focus-visible, li a.cta[aria-current='true'] { background: var(--white); color: var(--black); }
  .burger { display: none; border: 1px solid var(--line); border-radius: 999px; padding: .55rem 1.1rem; }
  @media (max-width: 820px) {
    .nav { background: rgba(8, 8, 8, .95); }
    .burger { display: block; position: relative; z-index: 2; }
    ul { position: fixed; inset: 0; background: var(--black); flex-direction: column; justify-content: center; gap: 1.8rem; transform: translateY(-100%); visibility: hidden; transition: transform .6s var(--ease), visibility 0s .6s; z-index: -1; }
    ul.open { transform: none; visibility: visible; transition: transform .6s var(--ease), visibility 0s; }
    li a { font-size: 1.3rem; }
    li a.cta { font-size: 1rem; }
  }
</style>
